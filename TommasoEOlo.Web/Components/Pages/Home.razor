<script>
    let effettohome = document.getElementsByClassName('tastohome');
    let testohome = document.getElementsByClassName('testo1');

    for (let i = 0; i < effettohome.length; i++) {
        effettohome[i].addEventListener("mouseover", () => {
            effettohome[i].style.background = "linear-gradient(to right, #ff6666, rgba(0, 184, 230, 0.8))";
            testohome[i].style.color = "white";
            testohome[i].style.background = "none";
            testohome[i].style.webkitBackgroundClip = "unset";
            testohome[i].style.webkitTextFillColor = "unset";
            testohome[i].style.backgroundClip = "unset";
        });

        effettohome[i].addEventListener("mouseout", () => {
            effettohome[i].style.background = "white";
            testohome[i].style.color = "transparent";
            testohome[i].style.background = "linear-gradient(to right, #ff6666, rgba(0, 184, 230, 0.8))";
            testohome[i].style.webkitBackgroundClip = "text";
            testohome[i].style.webkitTextFillColor = "transparent";
            testohome[i].style.backgroundClip = "text";
        });
    }

    function apriPopup() {
        document.getElementById("popupContatti").style.display = "flex";
    }

    function chiudiPopup() {
        document.getElementById("popupContatti").style.display = "none";
    }

    async function inviaModulo(event) {
        event.preventDefault();

        const form = event.target;
        const dati = {
            telefono: form.telefono.value,
            nome: form.nome.value,
            cognome: form.cognome.value,
            email: form.email.value
        };

        try {
            const response = await fetch('http://localhost:5309/api/dati', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dati)
            });

            if (!response.ok) {
                const errorData = await response.json();
                alert(`Errore: ${errorData.errore || 'Errore nell\'invio dei dati'}`);
                return;
            }

            document.getElementById('popupContatti').style.display = 'none';
            document.getElementById('popupConferma').style.display = 'block';
            setTimeout(() => {
                document.getElementById('popupConferma').style.display = 'none';
            }, 3000);
        } catch (err) {
            alert('Errore di rete o server');
            console.error(err);
        }
    }

        document.addEventListener('DOMContentLoaded', () => {
        const contenitoreMessaggi = document.getElementById('contenitoreMessaggi');
        const contenitoreinput = document.getElementById('contenitoreinput');
        const input = document.getElementById('valoreinput');
        const bottoneInvio = document.getElementById('tastoinvio');
        const typingIndicator = document.getElementById('typingIndicator');
        const selectModello = document.getElementById('modelloSelezionato');

        const modelloSelezio = selectModello.value;

        const suggerimentiComandi = document.getElementById('suggerimentiComandi');
        const comandiDisponibili = ['/immagine', '/delete', '/utilizzi'];
        const fileInput = document.getElementById("fileInput");
        const tastofile = document.getElementById("tastofile");
        const fileImportati = document.getElementById("fileImportati");

        let cronologiaChat = [];

        // Salva i contenuti testuali dei file ricevuti da /api/invio
        let contenutiFile = [];

         // Quando clicchi sull’icona file 📄
        tastofile.addEventListener("click", (e) => {
            e.preventDefault();
            fileInput.click();
        });

        fileInput.addEventListener("change", async () => {
        const files = fileInput.files;

        for (const file of files) {
            const formData = new FormData();
            formData.append("file", file);
            formData.append("modello", modelloSelezio);

            try {
                const response = await fetch('http://localhost:5309/api/invia', {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Errore nell'invio del file.");
                }

                const contenuto = await response.text();
                contenutiFile.push(contenuto); // salva il testo estratto

                // Mostra il nome del file nella UI
                const div = document.createElement("div");
                div.style.width = "40px";
                div.style.height = "40px";
                div.style.borderRadius = "50%";
                div.style.background = "linear-gradient(to right, rgba(0, 184, 230, 0.8), #ff6666)";
                div.style.boxShadow = "-6px 0 12px 0 rgba(0, 184, 230, 0.4), 6px 0 12px 0 rgba(255, 102, 102, 0.3)";
                div.style.transition = "border-color 0.3s ease, box-shadow 0.3s ease";
                div.style.display = "flex";
                div.style.alignItems = "center";
                div.style.justifyContent = "center";
                div.style.marginRight = "10px";
                div.style.cursor = "default";
                div.style.position = "relative";
                div.style.overflow = "hidden";
                div.style.marginBottom="10px"

                const before = document.createElement("div");
                before.style.position = "absolute";
                before.style.top = "2px";
                before.style.left = "2px";
                before.style.right = "2px";
                before.style.bottom = "2px";
                before.style.background = "white";
                before.style.borderRadius = "50%";
                before.style.zIndex = "1";
                div.appendChild(before);

                const img = document.createElement("img");
                img.src = "graffetta.png";
                img.style.width = "24px";
                img.style.height = "24px";
                img.style.position = "relative";
                img.style.zIndex = "2";
                img.style.pointerEvents = "none";

                div.appendChild(img);

                fileImportati.appendChild(div);

            } catch (error) {
                console.error("Errore durante il caricamento del file:", error);
                alert("Errore durante il caricamento del file.");
            }
        }
    });

            function aggiungiMessaggio(testo, classe, salva = true) {
        const div = document.createElement('div');
        div.className = classe;

        if (classe === 'immagine') {
            const img = document.createElement("img");
            img.src = testo;
            img.alt = "Immagine generata";
            img.style.maxWidth = "300px";
            img.style.borderRadius = "12px";
            img.style.margin = "10px 0";
            img.style.cursor = "pointer";
            img.setAttribute("draggable", "true");
            div.appendChild(img);
        } else if (classe === 'risposta-ai') {
            div.innerHTML = testo;
        } else {
            div.textContent = testo;
        }

        contenitoreMessaggi.insertBefore(div, typingIndicator);
        contenitoreMessaggi.scrollTop = contenitoreMessaggi.scrollHeight;

        if (classe === 'risposta-ai') {
            div.querySelectorAll('a').forEach(link => {
                let href = link.getAttribute('href');
                if (!href) return;
                if (!href.startsWith('http://') && !href.startsWith('https://')) {
                    href = 'https://' + href;
                }
                link.setAttribute('href', href);
                link.setAttribute('target', '_blank');
                link.setAttribute('rel', 'noopener noreferrer');
            });
        }

        if (salva) {
            cronologiaChat.push({ testo, classe });
            localStorage.setItem('conversazione', JSON.stringify(cronologiaChat));
        }
    }

        function mostraIndicatore() {
            typingIndicator.style.display = 'flex';
            contenitoreMessaggi.scrollTop = contenitoreMessaggi.scrollHeight;
        }

        function nascondiIndicatore() {
            typingIndicator.style.display = 'none';
        }

        function normalizzaTesto(str) {
            return str.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, "");
        }

        function htmlToText(html) {
            const tempDiv = document.createElement("div");
            tempDiv.innerHTML = html;
            return tempDiv.textContent || tempDiv.innerText || "";
        }

    async function verificaIntento(messaggioUtente, modelloSelezionato) {
        try {
            // Estrai l'ultima risposta dell'AI dalla cronologia (se c'è)
            let ultimaRispostaAI = [...cronologiaChat]
                .reverse()
                .find(msg => msg.classe === "risposta-ai")?.testo || "";

            ultimaRispostaAI = htmlToText(ultimaRispostaAI);

            const response = await fetch('http://localhost:5309/api/intento', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    MessaggioUtente: messaggioUtente,
                    UltimaRispostaAI: ultimaRispostaAI,
                    Modello: modelloSelezionato
                })
            });

            if (!response.ok) return "no";
            const data = await response.json();
            return data.intent?.toLowerCase() || "no";
        } catch (err) {
            console.warn("Errore durante la verifica intento:", err);
            return "no";
        }
    }

                async function mostraImmagineNellaChat(url) {
        aggiungiMessaggio(url, 'immagine');
    }

    async function generaImmagine(promptItaliano, modello) {
        console.log("Sto provando a generare un immagine");
        const risposta = await fetch('http://localhost:5309/api/immagine', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: promptItaliano, modello: modello })
        });

        if (!risposta.ok) {
            const errore = await risposta.text();
            throw new Error(`Errore dal server: ${errore}`);
        }

        const { imageUrl } = await risposta.json();
        console.log("Immagine generata");

        mostraImmagineNellaChat(imageUrl);
    }

        async function verificaSeServeContesto(messaggio, modello) {
        try {
            const response = await fetch("http://localhost:5309/api/verificaContesto", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    messaggio: messaggio,
                    modello: modello
                })
            });

            if (!response.ok) {
                console.warn("Verifica contesto fallita. Errore HTTP:", response.status);
                return false; // fallback di sicurezza
            }

            const risultato = await response.json();
            return risultato.serveContesto === true;
        } catch (e) {
            console.warn("Errore nella verifica del contesto:", e);
            return false; // fallback in caso di errore di rete o altro
        }
    }


                    async function inviaMessaggio() {
        let testoGrezzzo = input.value.trim();
        const testo = normalizzaTesto(testoGrezzzo);
        const modelloSelezionato = selectModello.value;
        let tuaDomanda = "";
        let rispostaGenerata = "";
        let ultimaRispostaAI = [...cronologiaChat]
            .reverse()
            .find(msg => msg.classe === "risposta-ai")?.testo || "";

        if (!testo) return;

        suggerimentiComandi.style.display = 'none';

        if (testo === "/delete") {
            cronologiaChat = [];
            localStorage.removeItem('conversazione');
            [...contenitoreMessaggi.children].forEach(el => {
                if (el !== typingIndicator) contenitoreMessaggi.removeChild(el);
            });
            input.value = '';
            aggiungiMessaggio("🗑️ Conversazione eliminata.", "risposta-ai", false);
            return;
        }

        if (contenutiFile.length > 0) {
            const contenutoPulito = contenutiFile.join("\n\n").trim();
            contenutiFile = [];
            fileImportati.innerHTML = "";

            const testoNuovo = "🔗 " + testo;
            aggiungiMessaggio(testoNuovo, 'nuvoletta');
            input.value = '';
            input.disabled = true;
            bottoneInvio.disabled = true;
            mostraIndicatore();

            try {
                const response = await fetch('http://localhost:5309/api/file', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        testo: contenutoPulito,
                        domanda: testo,
                        modello: modelloSelezionato
                    })
                });

                const dati = await response.json();
                aggiungiMessaggio(dati.risposta, "risposta-ai");
            } catch (error) {
                aggiungiMessaggio("⚠️ Errore durante la generazione della risposta: " + error.message, "risposta-ai");
            } finally {
                nascondiIndicatore();
                input.disabled = false;
                bottoneInvio.disabled = false;
                input.focus();
            }

            return;
        }

        aggiungiMessaggio(testoGrezzzo, 'nuvoletta');
        input.value = '';
        input.disabled = true;
        bottoneInvio.disabled = true;
        mostraIndicatore();

        if (testoGrezzzo.startsWith("/immagine ")) {
            const desc = testoGrezzzo.slice(9).trim();
            aggiungiMessaggio("Sto generando l'immagine...", "risposta-ai");

            try {
                await generaImmagine(desc, modelloSelezionato);
            } catch (e) {
                aggiungiMessaggio(`Errore generazione immagine: ${e.message}`, "risposta-ai");
            }

            nascondiIndicatore();
            input.disabled = false;
            bottoneInvio.disabled = false;
            input.focus();
            return;
        }

        // Intento + contesto in parallelo
        let intento, serveContesto;
        try {
            [intento, serveContesto] = await Promise.all([
                verificaIntento(testoGrezzzo, modelloSelezionato),
                verificaSeServeContesto(testoGrezzzo, modelloSelezionato)
            ]);
        } catch (e) {
            console.warn("Errore nella verifica intento o contesto:", e);
        }

        console.log("Intento rilevato:", intento);
        console.log("Serve il contesto:", serveContesto);

        if (intento === "si") {
            ultimaRispostaAI = htmlToText(ultimaRispostaAI);
            testoGrezzzo = `Sì, approfondisci questa domanda: "${testoGrezzzo}" basandoti su questa risposta che hai dato prima: "${ultimaRispostaAI}"`;
        }

        try {
            console.log("Avvio richiesta a /api/chat");
            const response = await fetch('http://localhost:5309/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Messaggio: testoGrezzzo,
                    Modello: modelloSelezionato,
                    UsaContesto: serveContesto
                })
            });

            if (!response.ok) {
                const text = await response.text();
                if (text.startsWith("LIMITATA:")) {
                    aggiungiMessaggio(text, 'risposta-ai');
                } else {
                    aggiungiMessaggio(`Errore server: ${response.status}`, 'risposta-ai');
                }
            } else {
                const data = await response.json();
                aggiungiMessaggio(data.testo || 'Nessuna risposta', 'risposta-ai');
                rispostaGenerata = data.testo || 'Nessuna risposta';
                tuaDomanda = testoGrezzzo;

                if (Array.isArray(data.contesto)) {
                    data.contesto.forEach((c, i) => {
                        console.log(`Contesto ${i + 1}:`, c);
                    });
                }

                if (rispostaGenerata.length > 10) {
                    // Salvataggio non bloccante
                    fetch('http://localhost:5309/api/salva', {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ Domanda: tuaDomanda, Risposta: rispostaGenerata })
                    });
                }
            }
        } catch (err) {
            console.warn("Errore durante la richiesta", err);
            try {
                const responseFallback = await fetch('http://localhost:5309/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        Messaggio: testoGrezzzo,
                        Modello: modelloSelezionato,
                        UsaContesto: false
                    })
                });

                const dataFallback = await responseFallback.json();
                aggiungiMessaggio(dataFallback.testo || 'Nessuna risposta', 'risposta-ai');
            } catch (errorFallback) {
                aggiungiMessaggio(`Errore connessione fallback: ${errorFallback.message}`, 'risposta-ai');
            }
        }

        nascondiIndicatore();
        input.disabled = false;
        bottoneInvio.disabled = false;
        input.focus();
        console.log("Fine processo");
    }

        bottoneInvio.addEventListener('click', inviaMessaggio);
        input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                inviaMessaggio();
            }
        });

        input.addEventListener('input', () => {
            const testo = input.value;
            if (testo.startsWith('/')) {
                const corrispondenze = comandiDisponibili.filter(c => c.startsWith(testo));
                if (corrispondenze.length > 0) {
                    suggerimentiComandi.innerHTML = '';
                    corrispondenze.forEach(comando => {
                        const div = document.createElement('div');
                        div.textContent = comando;
                        div.addEventListener('click', () => {
                            input.value = comando;
                            suggerimentiComandi.style.display = 'none';
                            input.focus();
                        });
                        suggerimentiComandi.appendChild(div);
                    });

                    const rect = input.getBoundingClientRect();
                    suggerimentiComandi.style.top = `${rect.bottom + window.scrollY}px`;
                    suggerimentiComandi.style.left = `${rect.left + window.scrollX}px`;
                    suggerimentiComandi.style.width = `${rect.width}px`;
                    suggerimentiComandi.style.display = 'block';
                } else {
                    suggerimentiComandi.style.display = 'none';
                }
            } else {
                suggerimentiComandi.style.display = 'none';
            }
        });

        document.addEventListener('click', (e) => {
            if (!suggerimentiComandi.contains(e.target) && e.target !== input) {
                suggerimentiComandi.style.display = 'none';
            }
        });

        const chatSalvata = JSON.parse(localStorage.getItem('conversazione') || '[]');
        cronologiaChat = chatSalvata;
        chatSalvata.forEach(msg => {
            aggiungiMessaggio(msg.testo, msg.classe, false);
        });
    });
</script>

